import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Carga e inspección rápida
df = pd.read_csv("archivo.csv")
df.info()                      # Tipos de datos y conteo de no-nulos
df.isna().sum()                # Cantidad de valores faltantes por columna
df.describe()                  # Estadísticos resumen (media, mediana, cuartiles)

# 2. Limpieza y transformación
df["fecha"] = pd.to_datetime(df["fecha"])
df = df.drop_duplicates(subset=["id_orden"])
df["categoria"] = df["categoria"].str.strip().str.lower()

# 3. Filtrado, agrupación y cruce
resumen = (
    df[df["estado"] == "completado"]
    .groupby("categoria", as_index=False)
    .agg(ventas_totales=("monto", "sum"), ticket_promedio=("monto", "mean"))
    .sort_values("ventas_totales", ascending=False)
)

