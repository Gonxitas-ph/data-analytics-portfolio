### 🗄️ SQL (PostgreSQL / Estándar)
```sql
-- 1. Orden de ejecución lógico de una consulta:
-- FROM -> JOIN -> WHERE -> GROUP BY -> HAVING -> SELECT -> ORDER BY -> LIMIT

-- 2. CTE (Common Table Expression) + Window Function (Ranking y variación):
WITH ventas_mensuales AS (
    SELECT
        DATE_TRUNC('month', fecha_orden) AS mes,
        categoria,
        SUM(monto) AS total_ventas
    FROM ordenes
    WHERE estado = 'Completado'
    GROUP BY 1, 2
)
SELECT
    mes,
    categoria,
    total_ventas,
    LAG(total_ventas) OVER (PARTITION BY categoria ORDER BY mes) AS ventas_mes_anterior,
    RANK() OVER (PARTITION BY mes ORDER BY total_ventas DESC) AS ranking_categoria
FROM ventas_mensuales;

